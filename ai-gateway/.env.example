# ─── DailyNutry AI Gateway — environment ──────────────────────────────────
# Copy to `.env` and fill in. NEVER commit `.env` with real keys.

# ── LLM providers ──────────────────────────────────────────────────────────
# The router builds its provider chain from whichever keys are present here,
# in PROVIDER_ORDER. A provider with no key is simply skipped (not an error).
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ordered, comma-separated. First is primary; the rest are fallbacks.
# Only providers that also have a key configured above are actually used.
PROVIDER_ORDER=gemini,openai,anthropic

# Per-provider model override (optional — sensible defaults baked in).
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Fallback / guardrails knobs ────────────────────────────────────────────
LLM_TIMEOUT_MS=60000
# How many repair attempts when the LLM output fails Zod validation.
MAX_REPAIR_ATTEMPTS=2

# ── Gateway auth ───────────────────────────────────────────────────────────
# The app must send this as `x-api-key`. With this unset the gateway REFUSES
# every request — an unauthenticated gateway spends real money on each call.
#
# ⚠️ This is a single shared key. Any client that ships it (a mobile app in
# particular) hands it to whoever unpacks the binary, and it cannot tell one
# user from another. Treat it as a service credential, not a user identity.
GATEWAY_API_KEY=dev-local-key

# Set to "true" ONLY when the gateway sits behind a proxy you control that
# overwrites X-Forwarded-For. Exposed directly, a client can forge that header
# and mint a fresh rate-limit bucket per request.
TRUST_PROXY=false

# ── Device auth ────────────────────────────────────────────────────────────
# Each app install registers once (POST /api/auth/register) and receives its
# own token. Rate limits, daily quota and revocation key off that token, so a
# leaked GATEWAY_API_KEY no longer buys unlimited extraction.
#
# Leave "false" until an app build that registers devices is live, then set to
# "true". While it is false the shared key alone still grants access, with only
# an IP-based limit behind it.
REQUIRE_DEVICE_AUTH=false

# Extractions per device per UTC day. This is the ceiling on what a single
# leaked token can cost you.
DEVICE_DAILY_QUOTA=30

# ── Observability dashboard (/dashboard) ───────────────────────────────────
# HTTP Basic credentials. With either unset the dashboard returns 503 rather
# than exposing spend and provider data publicly.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me

# ── Persistence (optional — gateway degrades gracefully if unset) ───────────
# Without DATABASE_URL, request logs go to stdout instead of Postgres.
DATABASE_URL=postgres://dailynutry:dailynutry@localhost:5432/dailynutry
# Without REDIS_URL, image-hash caching and rate-limiting are disabled.
REDIS_URL=redis://localhost:6379
