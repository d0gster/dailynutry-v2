{
  "name": "dailynutry-ai-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "AI gateway for DailyNutry — provider abstraction, fallback, guardrails, cost tracking",
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:init": "node --env-file-if-exists=.env --experimental-strip-types src/db/init.ts",
    "supply-chain": "node ../scripts/supply-chain-check.mjs"
  },
  "dependencies": {
    "ioredis": "^5.4.1",
    "next": "^16.3.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  }
}
