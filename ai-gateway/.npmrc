# ─── Supply-chain hardening ────────────────────────────────────────────────
# See ../SECURITY.md for the reasoning behind each line.

# Do not execute dependency lifecycle scripts (preinstall/install/postinstall).
#
# This is the single highest-value setting here. Self-propagating npm worms
# spread through postinstall hooks: the moment a compromised version lands in
# your tree, its script runs with your shell's privileges — reading env vars,
# tokens and SSH keys, then publishing itself onward using any npm credential
# it finds. Blocking scripts means a malicious package has to be IMPORTED and
# CALLED to do anything, instead of firing automatically on `npm install`.
#
# Verified affordable for this project: an audit of the lockfile found exactly
# one package here with an install script (fsevents, macOS-only and optional).
# Re-check with `npm run supply-chain` after adding dependencies.
ignore-scripts=true

# Record exact versions instead of caret ranges. A range silently accepts the
# next patch release — including a compromised one published minutes ago.
save-exact=true

# Fail `npm audit` on high or critical findings.
audit-level=high

fund=false
