# ─── DailyNutry app — environment ──────────────────────────────────────────
# Copy to `.env` for local development. Expo inlines every EXPO_PUBLIC_*
# variable into the JS bundle at BUILD time.
#
# ⚠️ Nothing here is secret. These values ship inside the app binary and can be
# read by anyone who unpacks it. Never put a provider key (Gemini, OpenAI,
# Anthropic) in this file — those belong on the gateway only.

# Base URL of the ai-gateway.
#   - Development: leave unset. The app derives the dev machine's IP from Expo,
#     so a phone on the same Wi-Fi connects with no configuration.
#   - Production: REQUIRED, and must be https:// — the build throws without it
#     rather than silently pointing at localhost.
EXPO_PUBLIC_GATEWAY_URL=

# Credential sent as `x-api-key`, must match GATEWAY_API_KEY on the gateway.
# Shared by every install, so it identifies the app, not a user — use a
# different value per environment and rotate it if a build leaks.
EXPO_PUBLIC_GATEWAY_API_KEY=dev-local-key
