# ─── Supply-chain hardening ────────────────────────────────────────────────
# See ../SECURITY.md for the reasoning behind each line.

# Do not execute dependency lifecycle scripts (preinstall/install/postinstall).
#
# Self-propagating npm worms spread through postinstall hooks: a compromised
# version that lands in the tree runs code immediately on `npm install`, with
# access to env vars, tokens and any npm credential it can reuse to publish
# itself onward. Blocking scripts forces a malicious package to be imported and
# called before it can act.
#
# ⚠️ Expo/React Native caveat: `npx expo prebuild` and native builds may need a
# package's install script. If a native build fails after this, re-run that one
# step with `npm rebuild <package>` rather than removing this line — that keeps
# the exception explicit and scoped instead of reopening the door for every
# package in the tree.
#
# Verified affordable: a lockfile audit found two packages with install scripts
# (fsevents, macOS-only; unrs-resolver, an ESLint dev dependency).
ignore-scripts=true

# Record exact versions instead of caret ranges, so a patch release cannot be
# picked up silently.
save-exact=true

audit-level=high

fund=false
